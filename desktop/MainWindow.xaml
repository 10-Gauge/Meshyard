<Window
    x:Class="Meshyard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Meshyard.Views"
    xmlns:svc="using:Meshyard.Services"
    Title="Meshyard">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (drawn by the app; the caption buttons stay the system's) -->
        <Grid x:Name="AppTitleBar" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="18" Height="18" />
                <TextBlock Text="Meshyard" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleSub" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="232"
            IsEnabled="False"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavBrowse" Content="Browse" Tag="browse" ToolTipService.ToolTip="Browse ships, vehicles and items">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Characters" Tag="characters" ToolTipService.ToolTip="Build a posed, armored character figure">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Blender sandbox" Tag="blender" ToolTipService.ToolTip="Spawn assets into a Blender scene">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA86;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- Browse / Characters workspace -->
                <Grid x:Name="WorkArea" Padding="16,4,16,16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="GameBox" MinWidth="170" SelectedIndex="0"
                                  ToolTipService.ToolTip="Which kind of game to read">
                            <ComboBoxItem Content="CryEngine Games" />
                        </ComboBox>
                        <ComboBox x:Name="InstallBox" Grid.Column="1" MinWidth="200" PlaceholderText="No game data" SelectionChanged="InstallBox_SelectionChanged"
                                  ToolTipService.ToolTip="Which build of the game data to browse" />
                        <TextBlock x:Name="BuildText" Grid.Column="2" Style="{StaticResource Secondary}" VerticalAlignment="Center"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="FindDataButton" AutomationProperties.Name="Find data files" Grid.Column="3" Click="FindData_Click"
                                ToolTipService.ToolTip="Look for CryEngine game data files on this PC, or pick one yourself">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="Find data files" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReindexButton" AutomationProperties.Name="Update index" Grid.Column="4" Click="Reindex_Click"
                                ToolTipService.ToolTip="Re-read the selected game data (run after each patch)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Update index" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="8">
                    <!-- a newer release on GitHub (checked each time the app opens) -->
                    <InfoBar x:Name="UpdateBar" Severity="Success" IsClosable="True"
                             Title="A new version is available">
                        <InfoBar.Content>
                            <StackPanel Spacing="8" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="UpdateButton" Content="Update now" Click="Update_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            ToolTipService.ToolTip="Download the new version and restart the app" />
                                    <HyperlinkButton x:Name="UpdateNotes" Content="What's new" />
                                </StackPanel>
                                <ProgressBar x:Name="UpdateProgress" Maximum="1" Visibility="Collapsed" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>

                    <InfoBar x:Name="ToolsBar" Severity="Warning" IsClosable="False"
                             Title="Game tools needed"
                             Message="StarBreaker and cgf-converter read the game files. They're free and download in a minute.">
                        <InfoBar.ActionButton>
                            <Button x:Name="ToolsButton" Content="Download tools" Click="Tools_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- shown whenever Blender can't be found (closable for this session) -->
                    <InfoBar x:Name="BlenderBar" Severity="Informational" IsClosable="True" Closed="BlenderBar_Closed"
                             Title="Blender isn't installed"
                             Message="Landing gear up, deployed weapons, FBX / USDZ / .blend export and the Blender sandbox need it. It's free.">
                        <InfoBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                <HyperlinkButton x:Name="BlenderDownload" Content="Download Blender 5.2 (blender.org)"
                                                 NavigateUri="https://download.blender.org/release/Blender5.2/blender-5.2.2-windows-x64.msi" />
                                <Button Content="Check again" Click="BlenderCheck_Click"
                                        ToolTipService.ToolTip="Look for Blender again after installing it" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>
                    </StackPanel>

                    <Grid x:Name="Workspace" Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" MinWidth="320" />
                            <ColumnDefinition Width="372" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Pane}">
                            <Grid>
                                <views:BrowsePanel x:Name="Browse" />
                                <views:CharacterPanel x:Name="Characters" Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Pane}">
                            <Grid>
                                <WebView2 x:Name="ViewerWeb" Margin="1" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="10"
                                            HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button x:Name="ResetViewButton" AutomationProperties.Name="Reset view" Click="ResetView_Click" Padding="8"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Reset the view (or double-click the model)">
                                        <FontIcon Glyph="&#xE8B3;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Pane}">
                            <views:Inspector x:Name="Inspector" />
                        </Border>

                        <!-- Empty / not indexed / indexing states, over the list and viewer -->
                        <Border x:Name="StateOverlay" Grid.ColumnSpan="2" Style="{StaticResource Pane}"
                                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" Visibility="Collapsed">
                            <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24">
                                <FontIcon x:Name="StateIcon" Glyph="&#xE7BA;" FontSize="40" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <ProgressRing x:Name="StateRing" IsActive="False" Visibility="Collapsed" Width="40" Height="40" />
                                <TextBlock x:Name="StateTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock x:Name="StateText" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="StateActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <views:BlenderPage x:Name="BlenderPage" Visibility="Collapsed" />
                <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <!-- Startup -->
        <Grid x:Name="Splash" Grid.Row="1" Background="Transparent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="560">
                <Image x:Name="SplashIcon" Width="96" Height="96" />
                <TextBlock Text="Meshyard" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                <ProgressRing x:Name="SplashRing" IsActive="True" Width="32" Height="32" />
                <TextBlock x:Name="SplashText" Text="Starting…" Style="{StaticResource Secondary}" HorizontalAlignment="Center" TextAlignment="Center" />
                <InfoBar x:Name="SplashError" Severity="Error" IsClosable="False" Title="The engine didn't start">
                    <InfoBar.ActionButton>
                        <Button Content="Try again" Click="Retry_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </Grid>

        <!-- Activity: background jobs and errors -->
        <ItemsControl x:Name="Activity" Grid.Row="1" Width="400" Margin="0,0,24,24"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <ItemsControl.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </ItemsControl.ItemContainerTransitions>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="svc:JobItem">
                    <InfoBar IsOpen="True" Margin="0,8,0,0" Title="{x:Bind Title, Mode=OneWay}"
                             Message="{x:Bind Detail, Mode=OneWay}" Severity="{x:Bind Severity, Mode=OneWay}"
                             Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                             CloseButtonClick="Job_Close">
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind IsRunning, Mode=OneWay}" Margin="0,0,0,10" />
                    </InfoBar>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
