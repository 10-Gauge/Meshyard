<UserControl
    x:Class="Meshyard.Views.BlenderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" Padding="36,8,36,36" Spacing="12">
            <TextBlock Text="Blender sandbox" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="StatusIcon" Glyph="&#xEA86;" FontSize="28" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" />
                        <HyperlinkButton x:Name="GetBlender" Content="Download Blender 5.2 (blender.org)" Padding="0" Margin="0,4,0,0"
                                         NavigateUri="https://download.blender.org/release/Blender5.2/blender-5.2.2-windows-x64.msi" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="InstallButton" Content="Install add-ons" Click="Install_Click"
                                ToolTipService.ToolTip="Install or update the Meshyard and StarBreaker add-ons in Blender" />
                        <Button x:Name="OpenButton" AutomationProperties.Name="Open sandbox" Style="{StaticResource AccentButtonStyle}" Click="Open_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                <TextBlock Text="Open sandbox" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <TextBlock Text="How it works" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="1.  Open the sandbox: Blender starts with an empty scene and the Meshyard panel." /><LineBreak />
                        <Run Text="2.  In Browse, pick a ship or item and choose Spawn. It's exported and queued here." /><LineBreak />
                        <Run Text="3.  In Blender, press N and open the Meshyard tab: queued assets appear in the scene." /><LineBreak />
                        <Run Text="4.  Spawn animated adds landing gear, door and ramp controls (in Blender's StarBreaker tab)." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="Spawn queue" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Click="Refresh_Click" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Content="Clear queue" Click="Clear_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="QueueEmpty" Text="Nothing queued yet." Style="{StaticResource Secondary}" />
                    <ItemsControl x:Name="Queue" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
