<UserControl
    x:Class="Meshyard.Views.BrowsePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Meshyard.Services">

    <Grid Padding="12,12,4,4" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <AutoSuggestBox x:Name="Search" Margin="0,0,8,0" QueryIcon="Find"
                        PlaceholderText="Search ships, vehicles, weapons, props…"
                        TextChanged="Search_TextChanged" QuerySubmitted="Search_QuerySubmitted" />

        <SelectorBar x:Name="Cats" Grid.Row="1" SelectionChanged="Cats_SelectionChanged" />

        <Grid Grid.Row="2" Margin="4,0,8,0">
            <TextBlock x:Name="CountText" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
            <CheckBox x:Name="RawGeo" Content="Raw geometry files" HorizontalAlignment="Right" MinWidth="0"
                      Checked="RawGeo_Changed" Unchecked="RawGeo_Changed"
                      ToolTipService.ToolTip="Also list the game's raw mesh files, not just named entities" />
        </Grid>

        <ListView x:Name="Results" Grid.Row="3" SelectionMode="Single" SelectionChanged="Results_SelectionChanged" SingleSelectionFollowsFocus="False"
                  IncrementalLoadingThreshold="3">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:AssetItem">
                    <StackPanel Padding="0,7" Spacing="1">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource Secondary}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="NoResults" Grid.Row="3" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Nothing matches" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Try another word, or a different category." Style="{StaticResource Secondary}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
