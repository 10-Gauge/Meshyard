<UserControl
    x:Class="SCAssetBrowser.Views.CharacterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="18,16,18,16" Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Character builder" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Pick a body, what it wears, a pose and a weapon, then build it."
                               Style="{StaticResource Secondary}" />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="BodyBox" Header="Body" HorizontalAlignment="Stretch" SelectionChanged="Body_Changed" />
                    <ComboBox x:Name="HeadBox" Grid.Column="1" Header="Head" HorizontalAlignment="Stretch" />
                </Grid>

                <ComboBox x:Name="PoseBox" Header="Pose" HorizontalAlignment="Stretch" SelectionChanged="Pose_Changed" />
                <AutoSuggestBox x:Name="WeaponBox" Header="Weapon" PlaceholderText="(none) — type to search rifles, pistols, launchers…"
                                QueryIcon="Find" />

                <TextBlock Text="Wearing" Style="{StaticResource SectionHeader}" Margin="0,10,0,0" />
                <StackPanel x:Name="Slots" Spacing="10" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="18,12" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BuildButton" AutomationProperties.Name="Build character" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="Build_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                            <TextBlock Text="Build character" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Content="Clear" Click="Clear_Click" ToolTipService.ToolTip="Take everything off" />
                </Grid>
                <StackPanel x:Name="Busy" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock x:Name="BusyText" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
